<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.infa.eic.sample</groupId>
    <artifactId>edc_catalog_utils_java</artifactId>
    <version>1.1</version>

    <dependencies>
        <!-- you will need to add the EDC client.jar to your local maven repository
        e.g. after downloading client.jar from your EDC installation/version
        use the EDC version the jar came from as the -Dversion value, e.g. for EDC 10.5.10:
        mvn install:install-file -Dfile=client.jar -DgroupId=com.infa.products.ldm.core.rest.v2.client
        -DartifactId=EDC-Rest-Client -Dversion=10.5.10 -Dpackaging=jar -DgeneratePom=true
        (the client usually works against older/newer EDC servers, except where the api has changed)
        -->
        <dependency>
            <groupId>com.infa.products.ldm.core.rest.v2.client</groupId>
            <artifactId>EDC-Rest-Client</artifactId>
            <version>10.5.10</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.15.0</version>
        </dependency>
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.12.0</version>
        </dependency>
        <!-- for FuzzyBGAssociater-->
        <dependency>
            <groupId>me.xdrop</groupId>
            <artifactId>fuzzywuzzy</artifactId>
            <version>1.4.0</version>
        </dependency>
        <!-- for structure diff -->
        <dependency>
            <groupId>com.googlecode.java-diff-utils</groupId>
            <artifactId>diffutils</artifactId>
            <version>1.3.0</version>
            <!-- 1.3.0 -->
        </dependency>
        <!-- for resource watch -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>javax.mail</artifactId>
            <version>1.6.2</version>
        </dependency>
        <!-- for v1 api calls (not covered in client.jar) -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.14</version>
        </dependency>

    </dependencies>

    <properties>
        <!-- java level to compile for: default 8 (backwards compatible for older edc/jdk installs)
             override on the command line to test other levels, e.g. mvn package -Djava.release=17
             using "release" (not source/target) also checks the code against that java version's api -->
        <java.release>8</java.release>
        <maven.compiler.release>${java.release}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                  <execution>
                    <phase>package</phase>
                    <goals>
                      <goal>single</goal>
                    </goals>
                    <configuration>
                      <appendAssemblyId>false</appendAssemblyId>
                      <descriptors>
                        <descriptor>assembly/zip.xml</descriptor>
                      </descriptors>
                      <!-- <finalName>${project.artifactId}</finalName> -->
                      <outputDirectory>${project.basedir}/packaged</outputDirectory>
                    </configuration>
                  </execution>
                </executions>
              </plugin>
        
        </plugins>
    </build>

    <profiles>
        <!-- optional vulnerability scan of all dependencies (including libraries bundled inside the EDC client jar)
             not part of the normal build - run with:
               mvn verify -Pdependency-check -DnvdApiKey=<your NVD api key>
             a free key is needed (https://nvd.nist.gov/developers/request-an-api-key)
             the first run downloads the NVD database (several minutes), later runs are much faster
             reports: target/dependency-check-report.html and .json
             the build is not failed on findings (failBuildOnCVSS=11) - review the report -->
        <profile>
            <id>dependency-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>13.0.0</version>
                        <configuration>
                            <failBuildOnCVSS>11</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>